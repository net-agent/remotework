{
  "links": {
    "txy": "tcp://localhost:2040?as=agent1&auth=dev_test_pswd",
    "txz": "tcp://localhost:2040?as=agent2&auth=dev_test_pswd"
  },

  "tunnels": [
    {
      "id": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e",
      "name": "forward: local <- agent2.txy:1080",
      "comment": "vnet=txy, local=agent1, remote=agent2",

      "listen": "tcp://localhost:1080",
      "target": "vtcp://agent2.txy:1080?authcode=mesh"
    },
    {
      "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
      "name": "agent1.socks5",
      "comment": "vnet=txy, local=agent1, remote=socks5 server",

      "listen": "vtcp://agent1.txy:1080?authcode=final",
      "target": "socks5://"
    },

    {
      "id": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6f",
      "name": "forward: agent2.txz:1080 <- agent1.txz:1080",
      "comment": "vnet=txz, local=agent2, remote=agent1",

      "listen": "vtcp://agent2.txz:1080?authcode=mesh",
      "target": "vtcp://agent1.txz:1080?authcode=final"
    }
  ],

  "trace": {
    "enable": false,
    "outputDir": "./traces",
    "dumpCap": 4096
  },

  "pprof": {
    "enable": false,
    "listen": "localhost:6060"
  }
}
