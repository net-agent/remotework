{
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "process:allow-exit",
    "process:allow-restart",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "remotework", "sidecar": true }]
    }
  ]
}
