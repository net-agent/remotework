# syntax=docker/dockerfile:1
# Agent 镜像：多阶段构建，产物为静态二进制，运行阶段使用 distroless 非 root 镜像。
#
# 构建（在仓库根目录执行）：
#   docker build -f ./DockerfileAgent \
#     --build-arg VERSION="$(git describe --tags --always)" \
#     --build-arg COMMIT="$(git rev-parse --short HEAD)" \
#     -t remotework/agent:latest .
#
# 运行（配置文件挂载到 /data/config.json；容器内默认以 nonroot 用户运行）：
#   docker run -d -p 8080:8080 \
#     -v "$PWD/config.json:/data/config.json:ro" \
#     --name remotework-agent remotework/agent:latest

# --- 构建阶段 ---
FROM golang:1.24 AS build

ARG VERSION=dev
ARG COMMIT=unknown

WORKDIR /src

# 先单独下载依赖，源码变更时可复用该层缓存。
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ENV CGO_ENABLED=0
RUN go build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o /out/remote ./cmd

# --- 运行阶段 ---
# distroless static 仅包含 CA 证书、时区等运行所需文件，无 shell/包管理器；
# :nonroot 变体默认以 UID/GID 65532 运行。
FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /data
COPY --from=build /out/remote /remote

ENTRYPOINT ["/remote"]
CMD ["-mode", "agent", "-c", "/data/config.json"]
